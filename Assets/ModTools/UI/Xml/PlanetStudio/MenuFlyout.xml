<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Design/DesignStyles.xml" />
  <Defaults></Defaults>
  <VerticalScrollView class="no-image">
    <VerticalLayout class="no-image" childForceExpandHeight="false" padding="20" spacing="10" contentSizeFitter="vertical" pivot="0 1" childAlignment="UpperCenter" rectAlignment="UpperLeft">
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnCreatePlanetButtonClicked();">
        <TextMeshPro text="{PlanetStudio.Menu.CreatePlanet}" />
      </Button>
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnLoadPlanetButtonClicked();">
        <TextMeshPro text="{PlanetStudio.Menu.LoadPlanet}" />
      </Button>
      <Image class="separator" />
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnCreateSystemButtonClicked();">
        <TextMeshPro text="{PlanetStudio.Menu.CreateSystem}" />
      </Button>
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnLoadSystemButtonClicked();">
        <TextMeshPro text="{PlanetStudio.Menu.LoadSystem}" />
      </Button>
      <Image class="separator" />
      <Button class="btn cb-only" rectAlignment="LowerLeft" onClick="OnSavePlanetButtonClicked();">
        <TextMeshPro text="{PlanetStudio.Menu.SavePlanet}" />
      </Button>
      <Button class="btn ps-only" rectAlignment="LowerLeft" onClick="OnSaveSystemButtonClicked();">
        <TextMeshPro text="{PlanetStudio.Menu.SaveSystem}" />
      </Button>
      <Image class="separator" />
      <Panel preferredHeight="40">
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Common/IconSettings" rectAlignment="MiddleLeft" offsetXY="15 0" onClick="OnSettingsButtonClicked();" tooltip="{PlanetStudio.Menu.Tooltip.Settings}" tooltipPosition="Above" />
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Common/IconButtonShare" rectAlignment="MiddleCenter" onClick="OnShareButtonClicked();" tooltip="{PlanetStudio.Menu.Tooltip.Upload}" tooltipPosition="Above" />
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Common/IconButtonCamera" rectAlignment="MiddleRight" offsetXY="-15 0" onClick="OnPhotoLibraryButtonClicked();" tooltip="{Menu.PhotoLibrary.Tooltip}" tooltipPosition="Above" id="photo-library-button" />
      </Panel>
      <Button class="btn btn-primary" rectAlignment="LowerLeft" onClick="OnHelpButtonClicked();">
        <TextMeshPro text="{PlanetStudio.Menu.Guide}" />
      </Button>
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnBugReportButtonClicked();" tooltip="{Menu.ReportBugButton.Tooltip}" device="desktop">
        <TextMeshPro text="{Menu.ReportBugButton.Text}" />
      </Button>
      <Image class="separator" />
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnExitButtonClicked();">
        <TextMeshPro text="{Menu.Exit}" />
      </Button>
    </VerticalLayout>
  </VerticalScrollView>
</XmlLayout>