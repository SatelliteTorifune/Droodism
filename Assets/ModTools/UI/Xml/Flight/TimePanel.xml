<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Flight/FlightStyles.xml" />
  <Defaults>
    <ContentButton class="time-button" color="Transparent" width="38" height="40" hoverClass="time-button-hover" tooltipPosition="Below" navigation="None" />
    <Image class="time-button&gt;@Image" width="20" height="20" color="PanelButton" />
    <Image class="time-button-hover&gt;@Image" color="PanelButtonHover" />
    <Image class="time-button-selected&gt;@Image" color="Primary" />
    <ContentButton class="time-warp-button" color="Transparent" tooltipPosition="Below" width="40" height="32" hoverClass="time-warp-button-hover" />
    <Image class="time-warp-arrow" sprite="Ui/Sprites/Common/IconChevronLeft" width="15" height="20" color="ButtonHover" />
    <Image class="time-warp-button-hover&gt;@Image" color="ButtonPressed" />
    <VerticalLayout class="time-panel" offsetXY="0 0" device="desktop" />
    <VerticalLayout class="time-panel" offsetXY="-50 0" device="mobile" />
  </Defaults>
  <VerticalLayout class="no-image time-panel" width="320" height="0" rectAlignment="UpperRight" contentSizeFitter="vertical" childAlignment="MiddleCenter">
    <Panel class="flight-panel" preferredHeight="40">
      <TextMeshPro id="time-text" onClickSound="Ui/Audio/ButtonClicked" class="value" text="00:00:00" width="118" height="50" rectAlignment="MiddleCenter" offsetXY="-20 0" alignment="Center" onClick="OnTimeClicked();" raycastTarget="true" />
      <ContentButton id="btn-pause" class="time-button audio-btn-click" rectAlignment="MiddleLeft" offsetXY="22 0" tooltip="{Flight.Pause.Paused}" onClick="OnPauseClicked();" name="TimePanel.Pause">
        <Image sprite="Ui/Sprites/Flight/IconTimePaused" />
      </ContentButton>
      <ContentButton id="btn-play" class="time-button audio-btn-click" rectAlignment="MiddleLeft" offsetXY="62 0" tooltip="{Flight.TimePanel.NormalSpeed}" onClick="OnPlayClicked();" name="TimePanel.Play">
        <Image sprite="Ui/Sprites/Flight/IconTimePlay" />
      </ContentButton>
      <ContentButton id="mode-slow" class="time-button audio-btn-click" rectAlignment="MiddleRight" offsetXY="-102 0" tooltip="{Flight.TimePanel.SlowMotion}" onClick="OnSlowMotionClicked();">
        <Image sprite="Ui/Sprites/Flight/IconTimeSlowMotion" />
      </ContentButton>
      <ContentButton id="mode-fast" class="time-button audio-btn-click" rectAlignment="MiddleRight" offsetXY="-62 0" tooltip="{Flight.TimePanel.FastForward}" onClick="OnFastForwardClicked();" name="TimePanel.FastForward">
        <Image sprite="Ui/Sprites/Flight/IconTimeFastForward" />
      </ContentButton>
      <ContentButton id="mode-warp" class="time-button audio-btn-click" rectAlignment="MiddleRight" offsetXY="-22 0" tooltip="{Flight.TimePanel.WarpSpeed}" onClick="OnWarpModeClicked();" name="TimePanel.Warp">
        <Image sprite="Ui/Sprites/Flight/IconTimeWarp" />
      </ContentButton>
    </Panel>
    <Panel id="adjust-panel" class="no-image" preferredHeight="36">
      <Panel class="flight-panel panel-angled" rotation="0 0 180" />
      <Panel id="speed-slider-panel" class="property-row slider" active="false">
        <Slider id="speed-slider" anchorMin="0 0.5" anchorMax="1 0.5" offsetMin="45 -10" offsetMax="-100 10" minValue="0" maxValue="1" wholeNumbers="true" value="0" />
        <TextMeshPro id="speed-slider-text" class="White" text="1x" alignment="Center" anchorMin="1 0.5" anchorMax="1 0.5" offsetMin="-90 -14" offsetMax="-45 14" />
      </Panel>
      <Panel id="warp-arrows-panel" class="no-image" active="false">
        <TextMeshPro id="warp-text" class="White" text="100x" width="120" alignment="Center" />
        <ContentButton class="time-warp-button audio-btn-click" rectAlignment="MiddleLeft" offsetXY="50 0" tooltip="{Flight.TimePanel.DecreaseWarpSpeed}" onClick="OnDecreaseWarpClicked();">
          <Image class="time-warp-arrow" />
        </ContentButton>
        <ContentButton class="time-warp-button audio-btn-click" rectAlignment="MiddleRight" offsetXY="-50 0" tooltip="{Flight.TimePanel.IncreaseWarpSpeed}" onClick="OnIncreaseWarpClicked();">
          <Image class="time-warp-arrow" rotation="0 0 180" />
        </ContentButton>
      </Panel>
    </Panel>
  </VerticalLayout>
</XmlLayout>