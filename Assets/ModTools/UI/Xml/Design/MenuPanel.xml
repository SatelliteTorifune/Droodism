<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Design/DesignStyles.xml" />
  <Defaults></Defaults>
  <VerticalScrollView class="no-image">
    <VerticalLayout class="no-image" childForceExpandHeight="false" padding="20" spacing="10" contentSizeFitter="vertical">
      <Button class="btn btn-primary" rectAlignment="LowerLeft" onClick="OnDownloadCraftButtonClicked();" tooltip="{Menu.DownloadCraftsTooltip}">
        <TextMeshPro text="{Menu.DownloadCrafts}" />
      </Button>
      <Image class="separator" />
      <Button class="btn btn-primary freemium-only" rectAlignment="LowerLeft" onClick="OnPurchaseButtonClicked();" tooltip="{Design.Menu.Upgrade.Tooltip}">
        <TextMeshPro text="{Design.Menu.Upgrade.Text}" />
      </Button>
      <Image class="separator freemium-only" />
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnNewCraftButtonClicked();" tooltip="{Menu.NewCraftTooltip}">
        <TextMeshPro text="{Menu.NewCraft}" />
      </Button>
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnLoadCraftButtonClicked();" tooltip="{Menu.LoadCraftTooltip}">
        <TextMeshPro text="{Menu.LoadCraft.Title}" />
      </Button>
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnSaveCraftButtonClicked();" tooltip="{Menu.SaveCraftTooltip}">
        <TextMeshPro text="{Menu.SaveCraft}" />
      </Button>
      <Image class="separator" />
      <Panel preferredHeight="40">
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Common/IconSettings" rectAlignment="MiddleLeft" offsetXY="15 0" onClick="OnSettingsButtonClicked();" tooltip="{Menu.Settings.Tooltip}" tooltipPosition="Above" id="share-sandbox-button" />
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Common/IconButtonShare" rectAlignment="MiddleCenter" onClick="OnShareCraftButtonClicked();" tooltip="{Design.UploadCraft.Tooltip}" tooltipPosition="Above" />
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Common/IconButtonCamera" rectAlignment="MiddleRight" offsetXY="-15 0" onClick="OnPhotoLibraryButtonClicked();" tooltip="{Menu.PhotoLibrary.Tooltip}" tooltipPosition="Above" id="photo-library-button" />
      </Panel>
      <Image class="separator career-mode" />
      <Button class="btn btn-primary career-mode" rectAlignment="LowerLeft" onClick="OnTechTreeButtonClicked();" tooltip="{Design.Menu.TechTree.Tooltip}">
        <TextMeshPro text="{Design.Menu.TechTree.Text}" />
      </Button>
      <Button class="btn btn-primary career-mode" rectAlignment="LowerLeft" onClick="OnCareerButtonClicked();" tooltip="{Design.Menu.Career.Tooltip}">
        <TextMeshPro text="{Design.Menu.Career.Text}" />
      </Button>
      <Image class="separator" />
      <Button class="btn" rectAlignment="LowerLeft" onClick="OnBugReportButtonClicked();" tooltip="{Menu.ReportBugButton.Tooltip}">
        <TextMeshPro text="{Menu.ReportBugButton.Text}" />
      </Button>
      <Image class="separator" />
      <Button class="btn audio-btn-big" rectAlignment="LowerLeft" onClick="OnExitButtonClicked();" tooltip="{Design.Exit.Tooltip}">
        <TextMeshPro text="{Menu.Exit}" />
      </Button>
    </VerticalLayout>
  </VerticalScrollView>
</XmlLayout>