<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Design/DesignStyles.xml" />
  <Defaults>
    <Spinner class="position-spinner" numericFormat="0.##" stepSize="0.1" minValue="-9999" maxValue="9999" />
  </Defaults>
  <VerticalLayout class="no-image" childForceExpandHeight="false" padding="20" spacing="10" pivot="0 1">
    <VerticalLayout id="content" class="no-image" childForceExpandHeight="false" spacing="10" pivot="0 1">
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.GridSize.Text}" tooltip="{Design.ToolPanel.NudgePart.GridSize.Tooltip}" />
        <Spinner id="spinner-grid-size" numericFormat="0.###" onNumericValueChanged="OnGridSizeSpinnerChanged();" stepSize="0.05" minValue="0" maxValue="2">
          <TextMeshProInputField contentType="DecimalNumber">
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.Transform.Mode.Text}" tooltip="{Design.ToolPanel.NudgePart.Mode.Tooltip}" />
        <Spinner id="spinner-mode" value="Connected" values="Self;Connected" localizationPrefix="Design.ToolPanel.Transform.Mode" onValueChanged="OnModeChanged(selectedValue);">
          <TextMeshPro />
        </Spinner>
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.NudgePart.Direction.Text}" tooltip="{Design.ToolPanel.NudgePart.Direction.Tooltip}" />
        <Spinner id="spinner-orientation" value="World" values="Local;World" localizationPrefix="Design.ToolPanel.Transform.Direction" onValueChanged="OnOrientationChanged(selectedValue);">
          <TextMeshPro />
        </Spinner>
      </Panel>
      <Panel id="template-header" class="header">
        <Panel height="35" rectAlignment="LowerCenter">
          <TextMeshPro internalId="label" text="{Design.ToolPanel.NudgePart.Position.Separator.Text}" fontStyle="Bold,UpperCase" />
        </Panel>
        <Image class="separator" />
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.NudgePart.Position.X.Text}" color="#e62e2e" tooltip="{Desgin.ToolPanel.NudgePart.Position.X.Tooltip}" />
        <Spinner id="spinner-x" class="position-spinner" numericFormat="0.###" onNumericValueChanged="OnPositionSpinnerChanged();">
          <TextMeshProInputField contentType="DecimalNumber">
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.NudgePart.Position.Y.Text}" color="#088f00" tooltip="{Desgin.ToolPanel.NudgePart.Position.Y.Tooltip}" />
        <Spinner id="spinner-y" class="position-spinner" numericFormat="0.###" onNumericValueChanged="OnPositionSpinnerChanged();">
          <TextMeshProInputField contentType="DecimalNumber">
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.NudgePart.Position.Z.Text}" color="#5670ff" tooltip="{Desgin.ToolPanel.NudgePart.Position.Z.Tooltip}" />
        <Spinner id="spinner-z" class="position-spinner" numericFormat="0.###" onNumericValueChanged="OnPositionSpinnerChanged();">
          <TextMeshProInputField contentType="DecimalNumber">
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
    </VerticalLayout>
    <TextMeshPro id="message-text" text="Message Text" preferredHeight="50" />
  </VerticalLayout>
</XmlLayout>