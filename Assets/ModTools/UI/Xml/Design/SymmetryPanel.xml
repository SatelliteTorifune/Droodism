<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Design/DesignStyles.xml" />
  <Defaults>
    <Panel class="tooltip-mirror" tooltip="{Design.Symmetry.MirrorMode.Tooltip}" />
    <Panel class="tooltip-radial" tooltip="{Design.Symmetry.RadialMode.Tooltip}" />
  </Defaults>
  <VerticalLayout class="no-image" childForceExpandHeight="false">
    <VerticalLayout id="symmetry-panel" class="no-image" childForceExpandHeight="false" padding="20" spacing="10" active="true">
      <Button id="select-root-button" class="btn btn-primary" rectAlignment="LowerLeft" width="150" onClick="OnSelectRootButtonClicked();" tooltip="{Design.Symmetry.SelectRoot.Tooltip}">
        <TextMeshPro text="{Design.Symmetry.SelectRoot.Text}" />
      </Button>
      <Panel id="spinner" preferredHeight="35" class="spinner row">
        <TextMeshPro text="{Design.Symmetry.Mode.Text}" class="label" rectAlignment="MiddleLeft" />
        <Spinner name="Symmetry.ModeSpinner" id="radial-spinner" rectAlignment="MiddleRight" width="70%">
          <TextMeshProInputField>
            <TMP_Text text="{Design.Symmetry.OptionMirror.Name}" />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <TextMeshPro id="message-text" text="Message Text" />
      <Button id="bake-symmetry-button" class="btn" rectAlignment="LowerLeft" width="150" onClick="OnBakeSymmetryButtonClicked();" tooltip="{Design.Symmetry.BreakSymmetry.Tooltip}">
        <TextMeshPro text="{Design.Symmetry.BreakSymmetry.Text}" />
      </Button>
      <TextMeshPro id="info-text" class="label" alignment="Center" text="{Design.Symmetry.InfoText}" />
    </VerticalLayout>
    <VerticalLayout id="quick-mirror-panel" class="no-image" childForceExpandHeight="false" padding="20" spacing="10" active="true">
      <Panel class="header" preferredHeight="30">
        <Panel class="no-image" height="35" rectAlignment="LowerCenter">
          <TextMeshPro text="{Design.Symmetry.QuickMirror.Text}" fontStyle="Bold,UpperCase" />
        </Panel>
        <Image class="separator" />
      </Panel>
      <TextMeshPro class="label tooltip" alignment="Center" text="{Design.Symmetry.QuickMirrorDescription.Text}" tooltip="{Design.Symmetry.QuickMirrorDescription.Tooltip}" />
      <Panel preferredHeight="40">
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Design/IconButtonMirrorRight" rectAlignment="MiddleLeft" offsetXY="15 0" onClick="OnMirrorCraftButtonClicked(false);" tooltip="{Design.Symmetry.QuickMirrorRight.Tooltip}" tooltipPosition="Above" id="share-sandbox-button" />
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Design/IconButtonMirrorPart" rectAlignment="MiddleCenter" onClick="OnMirrorPartButtonClicked();" tooltip="{Design.Symmetry.MirrorTool.Tooltip}" tooltipPosition="Above" />
        <Button class="icon-button audio-btn-big" icon="Ui/Sprites/Design/IconButtonMirrorLeft" rectAlignment="MiddleRight" offsetXY="-15 0" onClick="OnMirrorCraftButtonClicked(true);" tooltip="{Design.Symmetry.QuickMirrorLeft.Tooltip}" tooltipPosition="Above" id="photo-library-button" />
      </Panel>
      <Button id="mirror-tool-button" class="btn" rectAlignment="LowerLeft" width="150" onClick="OnMirrorToolButton();" tooltip="{Design.Symmetry.MirrorTool.Tooltip}">
        <TextMeshPro text="{Design.Symmetry.MirrorTool.Text}" />
      </Button>
    </VerticalLayout>
    <VerticalLayout id="mirror-tool-panel" class="no-image" childForceExpandHeight="false" padding="20" spacing="10" active="false">
      <Panel class="header" preferredHeight="30">
        <Panel class="no-image" height="35" rectAlignment="LowerCenter">
          <TextMeshPro text="{Design.Symmetry.MirrorCraft.Text}" fontStyle="Bold,UpperCase" />
        </Panel>
        <Image class="separator" />
      </Panel>
      <Panel preferredHeight="35" class="spinner row">
        <TextMeshPro text="{Design.Symmetry.MirrorRotation.Text}" class="label" rectAlignment="MiddleLeft" />
        <Spinner id="mirror-rotation-spinner" numericFormat="0.##" onNumericValueChanged="OnMirrorConfigurationChanged();" stepSize="90.0" minValue="-360" maxValue="360" width="70%">
          <TextMeshProInputField contentType="DecimalNumber">
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <Panel preferredHeight="35" class="spinner row">
        <TextMeshPro text="{Design.Symmetry.MirrorPosition.Text}" class="label" rectAlignment="MiddleLeft" />
        <Spinner id="mirror-location-spinner" numericFormat="0.##" onNumericValueChanged="OnMirrorConfigurationChanged();" stepSize="1.0" minValue="-100" maxValue="100" width="70%">
          <TextMeshProInputField contentType="DecimalNumber">
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <Image class="separator" />
      <Panel preferredHeight="30">
        <Button class="btn btn-primary" rectAlignment="MiddleRight" width="45%" onClick="OnMirrorToolOkayButtonClicked();">
          <TextMeshPro text="{Design.Symmetry.Mirror.Text}" />
        </Button>
        <Button class="btn" rectAlignment="MiddleLeft" width="45%" onClick="OnMirrorToolCancelButtonClicked();">
          <TextMeshPro text="{Dialog.Cancel}" />
        </Button>
      </Panel>
    </VerticalLayout>
  </VerticalLayout>
</XmlLayout>