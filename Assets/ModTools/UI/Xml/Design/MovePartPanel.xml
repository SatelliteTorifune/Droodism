<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Design/DesignStyles.xml" />
  <Defaults>
    <Spinner class="position-spinner" numericFormat="0.##" stepSize="0.1" minValue="-9999" maxValue="9999" />
  </Defaults>
  <VerticalLayout class="no-image" childForceExpandHeight="false" padding="20" spacing="10" pivot="0 1">
    <Panel class="spinner row">
      <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.GridSize.Text}" tooltip="{Design.ToolPanel.MovePart.GridSize.Tooltip}" />
      <Spinner id="spinner-grid-size" numericFormat="0.##" onNumericValueChanged="OnGridSizeChanged();" stepSize="0.05" minValue="0" maxValue="2">
        <TextMeshProInputField contentType="DecimalNumber">
          <TMP_Text />
        </TextMeshProInputField>
      </Spinner>
    </Panel>
    <Panel class="spinner row">
      <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.AngleSnap.Text}" tooltip="{Design.ToolPanel.MovePart.AngleSnap.Tooltip}" />
      <Spinner id="spinner-angle-snap" numericFormat="0.##" onNumericValueChanged="OnAngleSnapChanged();" stepSize="5.0" minValue="0" maxValue="180">
        <TextMeshProInputField contentType="DecimalNumber">
          <TMP_Text />
        </TextMeshProInputField>
      </Spinner>
    </Panel>
    <Panel class="row">
      <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.ShowResizeGizmos.Text}" rectAlignment="MiddleLeft" tooltip="{Design.ToolPanel.MovePart.ShowResizeGizmos.Tooltip}" />
      <Toggle id="enable-gizmos-toggle" rectAlignment="MiddleRight" onValueChanged="OnEnableGizmosChanged();" />
    </Panel>
    <Panel class="row">
      <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.ShowFuelFlow.Text}" rectAlignment="MiddleLeft" tooltip="{Design.ToolPanel.MovePart.ShowFuelFlow.Tooltip}" />
      <Toggle id="show-fuel-flow-toggle" rectAlignment="MiddleRight" onValueChanged="OnShowFuelFlowChanged();" />
    </Panel>
    <Panel class="row">
      <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.AutoRotateParts.Text}" rectAlignment="MiddleLeft" tooltip="{Design.ToolPanel.MovePart.AutoRotateParts.Tooltip}" />
      <Toggle id="enable-auto-rotation" rectAlignment="MiddleRight" onValueChanged="OnEnableAutoRotationChanged();" />
    </Panel>
    <Panel class="row">
      <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.ShowAttachPoints.Text}" rectAlignment="MiddleLeft" tooltip="{Design.ToolPanel.MovePart.ShowAttachPoints.Tooltip}" />
      <Toggle id="show-attach-points" rectAlignment="MiddleRight" onValueChanged="OnShowAttachPointsChanged();" />
    </Panel>
    <Panel class="row">
      <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.AttachToSurfaces.Text}" rectAlignment="MiddleLeft" tooltip="{Design.ToolPanel.MovePart.AttachToSurfaces.Tooltip}" />
      <Toggle id="enable-surface-attachments" rectAlignment="MiddleRight" onValueChanged="OnEnableSurfaceAttachmentsChanged();" />
    </Panel>
    <Panel class="row">
      <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.AutoResizeParts.Text}" rectAlignment="MiddleLeft" tooltip="{Design.ToolPanel.MovePart.AutoResizeParts.Tooltip}" />
      <Toggle id="enable-auto-resize" rectAlignment="MiddleRight" onValueChanged="OnEnableAutoResizeChanged();" />
    </Panel>
  </VerticalLayout>
</XmlLayout>