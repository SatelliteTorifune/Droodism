<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Design/DesignStyles.xml" />
  <Defaults>
    <Spinner class="angle-spinner" numericFormat="0.##" stepSize="30.0" minValue="-180" maxValue="180" numericWrap="true" />
  </Defaults>
  <VerticalLayout class="no-image" childForceExpandHeight="false" padding="20" spacing="10" pivot="0 1">
    <VerticalLayout id="content" class="no-image" childForceExpandHeight="false" spacing="10" pivot="0 1">
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.MovePart.AngleSnap.Text}" tooltip="{Design.ToolPanel.RotatePart.AngleSnap.Tooltip}" />
        <Spinner id="spinner-snap" numericFormat="0.##" onNumericValueChanged="OnSnapChanged();" stepSize="5.0" minValue="-1" maxValue="91">
          <TextMeshProInputField contentType="DecimalNumber">
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.Transform.Mode.Text}" tooltip="{Design.ToolPanel.RotatePart.Mode.Tooltip}" />
        <Spinner id="spinner-mode" value="Connected" values="Self;Connected" localizationPrefix="Design.ToolPanel.Transform.Mode" onValueChanged="OnModeChanged(selectedValue);">
          <TextMeshPro />
        </Spinner>
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.RotatePart.Direction.Text}" tooltip="{Design.ToolPanel.RotatePart.Direction.Tooltip}" />
        <Spinner id="spinner-orientation" value="World" values="Local;World" localizationPrefix="Design.ToolPanel.Transform.Direction" onValueChanged="OnOrientationChanged(selectedValue);">
          <TextMeshPro />
        </Spinner>
      </Panel>
      <Panel class="slider">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.RotatePart.Sensitivity.Text}" tooltip="{Design.ToolPanel.RotatePart.Sensitivity.Tooltip}" />
        <TextMeshPro id="sensitivity-text" class="value" text="None" />
        <Slider id="sensitivity-slider" onValueChanged="OnSensitivityChanged(selectedValue);" />
      </Panel>
      <Panel id="template-header" class="header">
        <Panel height="35" rectAlignment="LowerCenter">
          <TextMeshPro internalId="label" text="{Design.ToolPanel.RotatePart.Rotation.Separator.Text}" fontStyle="Bold,UpperCase" />
        </Panel>
        <Image class="separator" />
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.RotatePart.Rotation.X.Text}" color="#e62e2e" tooltip="{Design.ToolPanel.RotatePart.Rotation.X.Tooltip}" />
        <Spinner id="spinner-x" class="angle-spinner" onNumericValueChanged="OnAngleChanged();">
          <TextMeshProInputField>
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.RotatePart.Rotation.Y.Text}" color="#088f00" tooltip="{Design.ToolPanel.RotatePart.Rotation.Y.Tooltip}" />
        <Spinner id="spinner-y" class="angle-spinner" onNumericValueChanged="OnAngleChanged();">
          <TextMeshProInputField>
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
      <Panel class="spinner row">
        <TextMeshPro class="label tooltip" text="{Design.ToolPanel.RotatePart.Rotation.Z.Text}" color="#5670ff" tooltip="{Design.ToolPanel.RotatePart.Rotation.Z.Tooltip}" />
        <Spinner id="spinner-z" class="angle-spinner" onNumericValueChanged="OnAngleChanged();">
          <TextMeshProInputField>
            <TMP_Text />
          </TextMeshProInputField>
        </Spinner>
      </Panel>
    </VerticalLayout>
    <TextMeshPro id="message-text" text="Message Text" preferredHeight="50" />
  </VerticalLayout>
</XmlLayout>