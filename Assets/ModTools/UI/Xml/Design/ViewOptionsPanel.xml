<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Design/DesignStyles.xml" />
  <Defaults>
    <Color name="CenterOfMass" color="#CA2D2D" />
    <Color name="CenterOfLift" color="#378CFF" />
    <Color name="CenterOfThrust" color="#FFF93E" />
    <Button class="gizmo-toggle-button" onClickSound="Ui/Audio/ButtonClicked" sprite="" colors="Button|ButtonHover|Button|Button" icon="Ui/Sprites/Design/IconButtonCenterGizmo" navigation="None" width="40" height="40" tooltipPosition="Above" onClick="OnCenterGizmoClicked(this);" />
    <Button class="toggled" border="Primary" />
    <Button class="camera-focus-button" onClickSound="Ui/Audio/ButtonClicked" sprite="" rectAlignment="MiddleCenter" iconColor="Primary" iconHoverColor="Primary" colors="Button|ButtonHover|Button|Button" navigation="None" width="40" height="40" tooltipPosition="Above" />
  </Defaults>
  <VerticalLayout class="no-image" childForceExpandHeight="false" padding="20" spacing="10">
    <Panel class="header" preferredHeight="20">
      <Panel height="35" rectAlignment="LowerCenter">
        <TextMeshPro text="{Design.ViewOptions.CenterIndicators.Text}" fontStyle="Bold,UpperCase" />
      </Panel>
      <Image class="separator" />
    </Panel>
    <Panel class="no-image" preferredHeight="40">
      <Button id="gizmo-com" name="ViewOptions.CoM" class="gizmo-toggle-button" iconColor="CenterOfMass" iconHoverColor="CenterOfMass" offsetXY="-60 0" tooltip="{Design.ViewOptions.CenterOfMass.Tooltip}" />
      <Button id="gizmo-col" name="ViewOptions.CoL" class="gizmo-toggle-button" iconColor="CenterOfLift" iconHoverColor="CenterOfLift" offsetXY="0 0" tooltip="{Design.ViewOptions.CenterOfLift.Tooltip}" />
      <Button id="gizmo-cot" name="ViewOptions.CoT" class="gizmo-toggle-button" iconColor="CenterOfThrust" iconHoverColor="CenterOfThrust" offsetXY="60 0" tooltip="{Design.ViewOptions.CenterOfThrust.Tooltip}" />
    </Panel>
    <Panel class="spinner row">
      <TextMeshPro class="label tooltip" text="{Design.ViewOptions.Stage.Text}" width="50%" tooltip="{Design.ViewOptions.Stage.Tooltip}" />
      <Spinner id="stage-spinner" width="50%">
        <TextMeshPro text="{Design.ViewOptions.Stage.All}" />
      </Spinner>
    </Panel>
    <Panel class="header" preferredHeight="40">
      <Panel class="no-image" height="35" rectAlignment="LowerCenter">
        <TextMeshPro text="{Design.ViewOptions.CameraOptions.Text}" fontStyle="Bold,UpperCase" />
      </Panel>
      <Image class="separator" />
    </Panel>
    <Panel class="no-image" preferredHeight="40">
      <Button name="ViewOptions.ViewFront" class="camera-focus-button" offsetXY="-60 0" icon="Ui/Sprites/Design/IconButtonViewFront" tooltip="{Design.ViewOptions.CameraFront.Tooltip}" onClick="OnCameraClicked(front);" />
      <Button name="ViewOptions.ViewSide" class="camera-focus-button" offsetXY="0 0" icon="Ui/Sprites/Design/IconButtonViewSide" tooltip="{Design.ViewOptions.CameraSide.Tooltip}" onClick="OnCameraClicked(side);" />
      <Button name="ViewOptions.ViewTop" class="camera-focus-button" offsetXY="60 0" icon="Ui/Sprites/Design/IconButtonViewTop" tooltip="{Design.ViewOptions.CameraTop.Tooltip}" onClick="OnCameraClicked(top);" />
    </Panel>
    <Panel class="header" preferredHeight="40">
      <Panel class="no-image" height="35" rectAlignment="LowerCenter">
        <TextMeshPro text="{Design.ViewOptions.Other.Text}" fontStyle="Bold,UpperCase" />
      </Panel>
      <Image class="separator" />
    </Panel>
    <Panel class="no-image" preferredHeight="20" id="show-lift-panel">
      <TextMeshPro class="label tooltip" text="{Design.ViewOptions.ShowLiftVectors.Text}" rectAlignment="MiddleLeft" />
      <Toggle internalId="show-lift-button" isOn="false" onValueChanged="OnShowLiftVectorChanged(this);" rectAlignment="MiddleRight" tooltip="{Design.ViewOptions.ShowLiftVectors.Tooltip}" />
    </Panel>
    <Panel class="no-image" preferredHeight="20" id="show-pilot-panel">
      <TextMeshPro class="label tooltip" text="{Design.ViewOptions.Pilot.Text}" rectAlignment="MiddleLeft" />
      <Toggle internalId="show-pilot-button" isOn="false" onValueChanged="OnShowPilotChanged(this);" rectAlignment="MiddleRight" tooltip="{Design.ViewOptions.Pilot.Tooltip}" />
    </Panel>
    <Panel class="no-image" preferredHeight="20" id="select-command-pod-panel" active="false">
      <Button class="btn" onClick="OnSelectPartsAssociatedCommandPodClicked(this)" rectAlignment="MiddleRight" tooltip="{Design.ViewOptions.SelectCommandPod.Tooltip}">
        <TextMeshPro>{Design.ViewOptions.SelectCommandPod.Text}</TextMeshPro>
      </Button>
    </Panel>
    <Panel class="no-image" preferredHeight="20" id="select-background-color-panel">
      <Button class="btn" onClick="OnBackgroundColorClicked();" tooltip="{Design.ViewOptions.BackgroundColor.Tooltip}">
        <TextMeshPro text="{Design.ViewOptions.BackgroundColor.Text}" />
      </Button>
    </Panel>
  </VerticalLayout>
</XmlLayout>