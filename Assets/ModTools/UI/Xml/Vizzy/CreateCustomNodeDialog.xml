<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\XmlLayout.xsd">
  <Include path="Ui/Xml/Styles.xml" />
  <Defaults>
    <Panel class="column-left" width="50%" rectAlignment="MiddleLeft" />
    <Panel class="column-right" width="50%" rectAlignment="MiddleRight" padding="10 10 0 0" />
    <TextMeshPro class="node-instruction:node-header" text="{Vizzy.CreateCustomNode.Header.Instruction}" />
    <TextMeshPro class="node-instruction:node-description" text="{Vizzy.CreateCustomNode.Description.Instruction}" />
    <TextMeshPro class="node-instruction:node-description-ext" text="{Vizzy.CreateCustomNode.DescriptionExt.Instruction}" />
    <TextMeshPro class="node-expression:node-header" text="{Vizzy.CreateCustomNode.Header.Expression}" />
    <TextMeshPro class="node-expression:node-description" text="{Vizzy.CreateCustomNode.Description.Expression}" />
    <TextMeshPro class="node-expression:node-description-ext" text="{Vizzy.CreateCustomNode.DescriptionExt.Expression}" />
  </Defaults>
  <Panel id="panel" showAnimation="FadeIn" animationDuration="0.1" class="dialog-background">
    <VerticalLayout class="panel border" width="640" contentSizeFitter="vertical" spacing="10" padding="20">
      <TextMeshPro class="text-header node-header" />
      <TextMeshPro class="node-description label" />
      <TextMeshPro class="node-description-ext label" />
      <Panel id="node-panel" preferredHeight="80" color="DarkPanel"></Panel>
      <HorizontalLayout preferredHeight="40" spacing="10">
        <Button class="btn" onClick="OnCancelButtonClicked();">
          <TextMeshPro text="{Settings.Controls.Cancel}" />
        </Button>
        <Button class="btn" onClick="OnAddTextButtonClicked();">
          <TextMeshPro text="{Vizzy.CreateCustomNode.Button.AddText}" />
        </Button>
        <Button class="btn" onClick="OnAddParameterButtonClicked();">
          <TextMeshPro text="{Vizzy.CreateCustomNode.Button.AddParameter}" />
        </Button>
        <Button class="btn btn-primary" onClick="OnCreateButtonClicked();">
          <TextMeshPro text="{Dialog.Create}" />
        </Button>
      </HorizontalLayout>
    </VerticalLayout>
  </Panel>
</XmlLayout>