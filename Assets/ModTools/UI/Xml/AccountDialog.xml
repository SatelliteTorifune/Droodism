<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\XmlLayout.xsd">
  <Include path="Ui/Xml/Styles.xml" />
  <Defaults></Defaults>
  <Panel id="panel" showAnimation="FadeIn" hideAnimation="FadeOut" animationDuration="0.1" class="dialog-background">
    <VerticalLayout class="panel border" width="450" contentSizeFitter="vertical" spacing="10" padding="20">
      <VerticalLayout id="form" contentSizeFitter="vertical" spacing="10" padding="20">
        <TextMeshPro id="header-text" class="value text-lg" text="{Account.Dialog.Header}" minHeight="50" />
        <Panel class="row" padding="0">
          <TextMeshProInputField id="username-input" text="">
            <TMP_Placeholder text="{Account.Dialog.Username.Placeholder}" alignment="Center" />
            <TMP_Text text="" alignment="Center" />
          </TextMeshProInputField>
        </Panel>
        <Panel class="row" padding="0">
          <TextMeshProInputField id="password-input" text="" contentType="Password">
            <TMP_Placeholder text="{Account.Dialog.Password.Placeholder}" alignment="Center" />
            <TMP_Text text="" alignment="Center" />
          </TextMeshProInputField>
        </Panel>
        <HorizontalLayout id="lost-password" class="hide-row" preferredHeight="40" spacing="10" childForceExpandHeight="true" childForceExpandWidth="false" childAlignment="MiddleCenter">
          <TextMeshPro text="{Account.Dialog.LostPassword.Prefix}" />
          <TextMeshPro class="link" text="{Account.Dialog.LostPassword.Link}" onClick="OnLostPasswordClicked();" />
        </HorizontalLayout>
        <HorizontalLayout id="lost-password" class="hide-row" preferredHeight="40" spacing="10" childForceExpandHeight="true" childForceExpandWidth="false" childAlignment="MiddleCenter">
          <TextMeshPro text="{Account.Dialog.Register.Prefix}" />
          <TextMeshPro class="link" text="{Account.Dialog.Register.Link}" onClick="OnRegisterHereClicked();" />
        </HorizontalLayout>
      </VerticalLayout>
      <Panel id="profile" minHeight="128">
        <Panel rectAlignment="MiddleLeft" width="40%">
          <TextMeshPro text="{Scene.LoadingText}" />
          <RawImage id="profile-image" width="128" height="128" rectAlignment="MiddleLeft" />
        </Panel>
        <VerticalLayout rectAlignment="MiddleRight" width="60%" spacing="10">
          <TextMeshPro text="{Account.Dialog.LoggedInAs}" alignment="Left" opacity=".75" />
          <TextMeshPro id="profile-username" alignment="Left" />
          <HorizontalLayout height="30" spacing="10" childForceExpandHeight="false">
            <Button class="btn btn-primary audio-btn-big" onClick="OnViewProfileClicked();">
              <TextMeshPro text="{Account.Dialog.ViewProfile}" />
            </Button>
            <Button class="btn btn-danger audio-btn-big" onClick="OnDeleteProfileClicked();">
              <TextMeshPro text="{Account.Dialog.DeleteAccount}" />
            </Button>
          </HorizontalLayout>
        </VerticalLayout>
      </Panel>
      <Panel preferredHeight="50">
        <Button id="cancel-button" class="btn audio-btn-back" rectAlignment="LowerLeft" width="150">
          <TextMeshPro id="cancel-button-text" text="{Dialog.Close}" />
        </Button>
        <Button id="okay-button" class="btn btn-primary audio-btn-big" rectAlignment="LowerRight" width="150">
          <TextMeshPro id="okay-button-text" text="{Dialog.Okay}" />
        </Button>
        <Button id="logout-button" class="btn btn-primary audio-btn-big" rectAlignment="LowerRight" width="150" active="false">
          <TextMeshPro text="{Account.Dialog.Logout}" />
        </Button>
      </Panel>
    </VerticalLayout>
  </Panel>
</XmlLayout>